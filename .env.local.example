# Copy this file to .env.local (development) and fill in real values, or set
# these in your hosting platform's environment variables (production).
# See README.md → "Backend setup" for step-by-step instructions.

# PostgreSQL connection string.
# For local dev, run `npx prisma dev` in a separate terminal and copy the
# connection URL it prints — no Docker or manual Postgres install needed.
# For production, use a managed Postgres provider (Neon, Supabase, RDS, etc.).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Session cookie signing secret (admin auth, lib/auth/session.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-a-new-one-do-not-reuse-this-value"

# Seed-only: the admin account prisma/seed.ts creates on first run.
# Change the password immediately after first login; these vars aren't read
# again after seeding.
ADMIN_SEED_EMAIL="admin@thecinefilms.com"
ADMIN_SEED_PASSWORD="change-me-immediately"
